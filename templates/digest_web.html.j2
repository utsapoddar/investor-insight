<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alpha Digest — Week of {{ start_date }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', sans-serif; background: #0a0a0f; color: #f0f0f0; padding: 24px 16px 48px; }
  .wrapper { max-width: 680px; margin: 0 auto; }
  .header { margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.08); }
  .header h1 { font-size: 20px; font-weight: 700; color: #38CDD6; margin-bottom: 4px; }
  .header p { font-size: 13px; color: rgba(255,255,255,0.4); }
  .macro { background: rgba(56,205,214,0.08); border-left: 3px solid #38CDD6; padding: 12px 16px; border-radius: 0 8px 8px 0; margin-bottom: 16px; font-size: 14px; color: rgba(255,255,255,0.75); line-height: 1.6; }
  .macro strong { color: #38CDD6; }
  .commodities { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; }
  .commodities span { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 6px 12px; font-size: 13px; color: rgba(255,255,255,0.6); }
  .up { color: #2f9e44 !important; font-weight: 600; }
  .down { color: #f03e3e !important; font-weight: 600; }
  .entity { padding: 20px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .entity:last-child { border-bottom: none; }
  .entity-header { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .entity-name { font-size: 16px; font-weight: 700; color: #fff; }
  .entity-type { font-size: 11px; background: rgba(56,205,214,0.12); color: #38CDD6; border: 1px solid rgba(56,205,214,0.25); padding: 2px 8px; border-radius: 20px; text-transform: uppercase; font-weight: 600; letter-spacing: 0.04em; }
  .summary { font-size: 14px; line-height: 1.75; color: rgba(255,255,255,0.7); }
  .news-links { margin-top: 10px; font-size: 12px; }
  .news-links a { color: #38CDD6; text-decoration: none; margin-right: 10px; opacity: 0.8; }
  .news-links a:hover { opacity: 1; }
  .footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.06); font-size: 11px; color: rgba(255,255,255,0.25); text-align: center; }
</style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    <h1>Alpha Digest</h1>
    <p>Week of {{ start_date }} to {{ end_date }}</p>
  </div>

  {% if macro_note %}
  <div class="macro">
    <strong>Macro:</strong> {{ macro_note }}
  </div>
  {% endif %}

  {% if commodities %}
  <div class="commodities">
    {% for name, pct in commodities.items() %}
    <span>{{ name }}: <span class="{{ 'up' if pct >= 0 else 'down' }}">{{ '%+.2f' % pct }}%</span></span>
    {% endfor %}
  </div>
  {% endif %}

  {% for entity in entity_summaries %}
  <div class="entity">
    <div class="entity-header">
      <span class="entity-name">{{ entity.name }}</span>
      <span class="entity-type">{{ entity.type }}</span>
    </div>
    <div class="summary">{{ entity.summary }}</div>
    {% if entity.news_used %}
    <div class="news-links">
      Sources:
      {% for url in entity.news_used %}
      <a href="{{ url }}" target="_blank">Article {{ loop.index }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}

  <div class="footer">Data: SEC EDGAR · CoinGecko · Yahoo Finance · Google News &nbsp;·&nbsp; Not investment advice.</div>
</div>
</body>
</html>
